{
  "expo": {
    "name": "DyLearn",
    "slug": "dylearn",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "android": {
      "package": "com.dylearn.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_IMAGES",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      ["expo-media-library", { "savePhotosPermission": "Cho phép lưu video đã tải vào thư viện.", "isAccessMediaLocationEnabled": false }]
    ]
  }
}
